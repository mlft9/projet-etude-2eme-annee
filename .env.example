# Base de données (local Docker)
POSTGRES_DB=parcell_ia
POSTGRES_USER=parcell
POSTGRES_PASSWORD=parcell_secret

# Connexion DB (local: laisser vide = auto-construit depuis les vars ci-dessus)
# Azure: mettre la connection string complète ici
DATABASE_URL=
# SSL requis sur Azure PostgreSQL
DB_SSL=false

# Backend
PORT=3000
JWT_SECRET=change_me_in_production

# IA - Azure OpenAI (priorité 1)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_KEY=<ta_cle_azure>
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# IA - OpenAI direct (fallback si Azure KO)
OPENAI_API_KEY=<ta_cle_openai>

# IA - Gemini (plan B)
GEMINI_API_KEY=<ta_cle_gemini>
